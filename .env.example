# Copy to .env and fill in. Never commit real values.

# ─── Database and login ─────────────────────────────
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
JWT_EXPIRES_IN=7d
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Other systems reading or posting to the CRM ────
# ORION, the marketing platform (full access)
ORION_API_SECRET=
# Viktor (read-only)
VIKTOR_API_SECRET=
# The Make scenario (lead intake only)
MAKE_API_SECRET=

# ─── Receipts ───────────────────────────────────────
OPENAI_API_KEY=
BLOB_READ_WRITE_TOKEN=
RECEIPT_STORAGE_PROVIDER=
RECEIPT_EXTRACTION_PROVIDER=
RECEIPT_EXTRACTION_OPENAI_MODEL=
RECEIPT_EXTRACTION_OPENAI_URL=
RECEIPT_EXTRACTION_TIMEOUT_MS=
DEBUG_EXPENSE_UPLOADS=

# ─── Leads Inbox: webhooks ──────────────────────────
# Meta: any long random text, also typed in Meta for Developers when subscribing the webhook
META_WEBHOOK_VERIFY_TOKEN=
# Meta: the app's secret, used to check each delivery's signature
META_APP_SECRET=
# Meta: Page token with leads_retrieval, used to read each lead
META_PAGE_ACCESS_TOKEN=
# Google Ads: any long random text, also typed as the key in the lead form
GOOGLE_LEADS_WEBHOOK_KEY=
# Website: any long random text, sent by the server in the x-webhook-secret header
WEBSITE_LEADS_SECRET=

# ─── Leads Inbox: new lead email ────────────────────
RESEND_API_KEY=
# Optional. Without it, Resend's shared onboarding address sends the email.
RESEND_FROM_EMAIL=

# ─── Local tests only (scripts/simulate-leads.ts) ───
# META_GRAPH_BASE_URL=http://localhost:4599
